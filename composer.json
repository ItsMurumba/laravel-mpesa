{
    "name": "itsmurumba/laravel-mpesa",
    "description": "Laravel Package for Mpesa Daraja API",
    "license": "MIT",
    "keywords": [
        "mpesa",
        "payments",
        "itsmurumba",
        "daraja",
        "laravel",
        "laravel 11",
        "laravel 12",
        "laravel 13"
    ],
    "autoload": {
        "psr-4": {
            "Itsmurumba\\Mpesa\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Itsmurumba\\Mpesa\\Tests\\": "tests"
        }
    },
    "authors": [
        {
            "name": "Kelvin Murumba",
            "email": "kevmurumba@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.8|^4.0"
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Itsmurumba\\Mpesa\\MpesaServiceProvider"
            ],
            "aliases": {
                "Mpesa": "Itsmurumba\\Mpesa\\Facades\\Mpesa"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
